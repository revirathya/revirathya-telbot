# ------ Application ------
# Defined as application versioning or deployment environment

# [Defaulted] Running environment of application
# default: prod
APP_ENV=dev

# [Defaulted] Exposed port for webhook service.
# default: 8080
APP_PORT=8080

# [Required] Telegram Bot authorization token
TELEGRAM_BOT_TOKEN=

# [Required] Telegram Webhook open-public access URL path for Telegram server push. Define NGROK_HOST to use local `make http`
# and use used HTTP URL for this webhook 
TELEGRAM_WEBHOOK_URL=

# [Defaulted] NGROK registered http host. See ngrok local port forward guides
# default: ''
# NGROK_HOST=

# [Required] Finance gRPC service host
FINANCE_HOST=

# [Required] Finance gRPC service authorization key
FINANCE_API_KEY=

# ------ Docker & Makefile ------
# Used by Docker image build and deployment

# [Required] Application (Core) tags. Used by `make docker-build` / `make docker-up`
VERSION=0.1.0
